APP_URL=http://localhost:3000
DATABASE_URL=postgresql://katerina:replace-me@localhost:5432/katerina
# Use a separate migration role in production.
MIGRATION_DATABASE_URL=
DEMO_MODE=true
BOOKING_MODE=request
PROPERTY_DATA_VERIFIED=false
# Generate each secret separately: openssl rand -hex 32
RECEIPT_SECRET=
RATE_LIMIT_SECRET=
AUTH0_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_MFA_CLAIM=https://katerinastudios.example/mfa
EMAIL_FROM=Katerina Studios <demo@example.invalid>
OWNER_NOTIFICATION_EMAIL=owner@example.com
REAL_EMAIL_TEST=false
MEDIA_STORAGE=local
ICAL_ENCRYPTION_KEY=
ICAL_EXPORT_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Optional supplementary Google reviews. Keep the Places API key server-side.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Browser-visible key. Restrict it to website referrers and Maps Embed API.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
# Optional verified fallback link for a Google Places outage.
GOOGLE_MAPS_URL=
TRUST_PROXY=none
# Required only with the optional local-db compose profile.
LOCAL_DATABASE_PASSWORD=replace-me
